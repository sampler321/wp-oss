  {
   "title": "Green front door, Prussia Street",
   "category": "outside",
   "image": "frontdoor.jpg",
   "template": "single-job",
   "date": "2026-09-10",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">The owners wanted the door the colour of the one in the photo their grandmother kept. We never saw the photo, but we got close with Calke Green and a lot of squinting.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading has-x-large-font-size\">Colours on this job</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9.5rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"backgroundColor\":\"calke\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-calke-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Calke Green</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 34</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Door, exterior eggshell</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"base\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-base-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">All White</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 2005</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Columns and fanlight frame</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"contrast\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-contrast-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Railings</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 31</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Railings, metal paint</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we did</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Before</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Brown woodstain, peeling at the bottom rail</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Stripped to bare timber, filled, knotted, primed</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">2 days, one painter</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Cost</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">€560 with the railings</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">They sent a photo every evening, including the evening the dog walked through the primer.</p>\n<!-- /wp:paragraph --><cite>Emer, Prussia Street, September 2026</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Ask for a quote like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
  },
  {
   "title": "Wallpapered front room, Oxmantown Road",
   "category": "interiors",
   "image": "hero.jpg",
   "template": "single-job",
   "date": "2026-08-22",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">A patterned paper with a 53 cm repeat, which wastes about a roll in every four. Marek hung it. The red woodwork was the owner's idea and she was right.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading has-x-large-font-size\">Colours on this job</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9.5rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"backgroundColor\":\"accent\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-accent-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Bamboozle</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 304</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Skirting and doors, eggshell</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"calke\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-calke-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Calke Green</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 34</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Window shutters</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"plaster\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-plaster-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Setting Plaster</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 231</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Ceiling</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we did</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Paper</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Customer's own, a red trellis print, 11 rolls</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Lining paper hung first, crossways</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">6 days, two of us</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Cost</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">€2,700 plus the paper</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">Marek matched the pattern round the chimney breast so well I can't find the join.</p>\n<!-- /wp:paragraph --><cite>Lucy, Oxmantown Road, August 2026</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Ask for a quote like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
  },
  {
   "title": "Mint kitchen with red trim, Cabra",
   "category": "kitchens",
   "image": "kitchen.jpg",
   "template": "single-job",
   "date": "2026-07-30",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Laminate doors can be painted if you prime them properly. These had 40 years of frying on them, so day one was mostly sugar soap and patience.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading has-x-large-font-size\">Colours on this job</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9.5rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"backgroundColor\":\"mint\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-mint-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Mint</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Colortrend match</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Cabinets, eggshell, brushed</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"accent\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-accent-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Bamboozle</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 304</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Window frame</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"babouche\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-babouche-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Babouche</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 223</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Inside the dresser</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we did</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Before</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">1980s oak-effect laminate doors</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Degreased twice, keyed, bonding primer</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">6 days</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Cost</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">€2,900 for 16 doors and 6 drawers</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">The kitchen looks like we bought a new one, and we still have the money.</p>\n<!-- /wp:paragraph --><cite>Declan and Joy, Cabra, July 2026</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Ask for a quote like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
  },
  {
   "title": "Orange sitting room with black panels, Drumcondra",
   "category": "interiors",
   "image": "decorator.jpg",
   "template": "single-job",
   "date": "2026-07-12",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">The owner sent us a photo of a museum room and asked for that. Three coats of orange later, it looks like that, minus the rope barrier.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading has-x-large-font-size\">Colours on this job</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9.5rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"backgroundColor\":\"locks\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-locks-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Charlotte's Locks</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 268</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Walls</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"contrast\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-contrast-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Railings</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 31</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Panels and skirting</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"plaster\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-plaster-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Setting Plaster</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 231</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Ceiling</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we did</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Rooms</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Sitting room, 4.2 × 5.1 m</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Coats</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Three on the walls, oranges cover badly</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">4 days</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Cost</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">€1,450</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">Aoife held a sample board up at nine at night to prove the orange worked by lamplight.</p>\n<!-- /wp:paragraph --><cite>Gráinne, Drumcondra, July 2026</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Ask for a quote like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
  },
  {
   "title": "Red drawing room and gothic windows, Glasnevin",
   "category": "heritage",
   "image": "stairs.jpg",
   "template": "single-job",
   "date": "2026-06-18",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">The conservation officer came twice. The second visit was to look at the putty, which she said was fine, and which Aoife has mentioned every day since.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading has-x-large-font-size\">Colours on this job</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9.5rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"backgroundColor\":\"accent\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-accent-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Bamboozle</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 304</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Walls, limewash-friendly emulsion</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"plaster\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-plaster-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Setting Plaster</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 231</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Window reveals</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"stiffkey\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-stiffkey-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Stiffkey Blue</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 281</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Inside the shutters</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we did</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Building</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Protected structure, 1860s</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Windows</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Three gothic sashes stripped and re-puttied</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Paint</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Linseed oil paint on the timber</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">3 weeks</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">The conservation officer asked who did the putty. We gave her Aoife's number.</p>\n<!-- /wp:paragraph --><cite>Muireann, Glasnevin, June 2026</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Ask for a quote like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
  },
  {
   "title": "Cottage, render and sash, Skerries",
   "category": "outside",
   "image": "sash.jpg",
   "template": "single-job",
   "date": "2026-06-02",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Outside our usual patch, but a thatched cottage does not come along often. Limewash goes on thin and looks awful for an hour, then dries perfectly.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading has-x-large-font-size\">Colours on this job</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9.5rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"backgroundColor\":\"base\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-base-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Limewash, white</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Mixed on site</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Walls, four coats</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"calke\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-calke-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Calke Green</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 34</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Sills and door</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"base\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-base-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Pure white oil</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Linseed paint</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Sash window</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we did</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Walls</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Lime render, so limewash, never masonry paint</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">5 days in June</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Travel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Outside our area, so we charged mileage</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Cost</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">€3,300</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">Worth the drive out, they said. We agree.</p>\n<!-- /wp:paragraph --><cite>Seán, Skerries, June 2026</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Ask for a quote like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
  },
  {
   "title": "Blue steel yard doors, Kirwan Street",
   "category": "outside",
   "image": "door.jpg",
   "template": "single-job",
   "date": "2026-05-15",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Our own neighbour's yard doors. The blue was matched to a bottle top he gave us.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading has-x-large-font-size\">Colours on this job</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9.5rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"backgroundColor\":\"door-blue\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-door-blue-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Door blue</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Mixed to sample</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Steel doors, two coats</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"contrast\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-contrast-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Railings</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 31</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Hinges and frame</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we did</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Surface</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Galvanised steel</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Wire-brushed, T-washed, etch primer</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">1 day</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Cost</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">€420</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">Our yard doors are now the most photographed thing on Kirwan Street.</p>\n<!-- /wp:paragraph --><cite>Pat, Kirwan Street, May 2026</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Ask for a quote like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
  },
  {
   "title": "Colours we stole from holidays",
   "category": "notes",
   "image": "exterior.jpg",
   "template": "single-job",
   "date": "2026-02-20",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Every winter we each bring back one colour from somewhere warm and try to match it. Dublin light makes everything greyer, so we mix a shade brighter than the photo.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading has-x-large-font-size\">Colours on this job</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9.5rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"backgroundColor\":\"yellowcake\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-yellowcake-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Yellowcake</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 279</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Symi harbour yellow, near enough</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"mint\",\"textColor\":\"contrast\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-contrast-color has-text-color has-mint-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Mint</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Colortrend match</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Isla Margarita walls</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"backgroundColor\":\"accent\",\"textColor\":\"base\",\"className\":\"is-style-chip\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-chip has-base-color has-text-color has-accent-background-color has-background\"><!-- wp:paragraph -->\n<p class=\"\">Bamboozle</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">F&amp;B No. 304</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Isla Margarita door</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we did</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Photos</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Aoife in Symi, Tunde on Isla Margarita</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Used so far</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Mint and red, on a house in Marino</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">We came for the holiday photos and stayed for the colour visit.</p>\n<!-- /wp:paragraph --><cite>Nadia, Marino, February 2026</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Ask for a quote like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
