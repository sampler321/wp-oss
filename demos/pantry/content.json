  {
   "title": "Shakshuka with preserved lemon and feta",
   "slug": "shakshuka-preserved-lemon",
   "category": "dinner",
   "tags": [
    "Vegetarian",
    "Eggs",
    "Under 30 minutes",
    "Tins"
   ],
   "image": "hero.jpg",
   "excerpt": "35 minutes, serves 4. Everything in it keeps, which is why we have it on Mondays.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">This is what we eat on Mondays, because everything in it keeps: tins, eggs, a jar of preserved lemons. The lemon is the thing people ask about. It makes the sauce taste like it cooked for longer than it did.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"anchor\":\"recipe\",\"className\":\"is-style-recipe-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div id=\"recipe\" class=\"wp-block-group is-style-recipe-card\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n<h2 class=\"wp-block-heading has-xx-large-font-size\">Shakshuka with preserved lemon and feta</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\",\"textColor\":\"muted\",\"className\":\"no-print\"} -->\n<p class=\"no-print has-muted-color has-text-color has-x-small-font-size\">Print it and the photos and comments drop out.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Serves</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">4</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">10 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Cook</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">25 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Total</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">35 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Ingredients</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-ingredients\"} -->\n<ul class=\"wp-block-list is-style-ingredients\"><!-- wp:list-item -->\n<li><strong>3 tbsp</strong> olive oil</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>2</strong> onions, thinly sliced</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>2</strong> red peppers, sliced</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>3</strong> garlic cloves, crushed</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>2 tsp</strong> cumin seeds</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1 tbsp</strong> rose harissa</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>800g</strong> tinned plum tomatoes (2 tins)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>½</strong> preserved lemon, rind only, chopped</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>6</strong> eggs</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>100g</strong> feta (¾ cup crumbled)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>A small bunch of coriander</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Method</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true,\"className\":\"is-style-steps\"} -->\n<ol class=\"wp-block-list is-style-steps\"><!-- wp:list-item -->\n<li>Heat the oil in a 28cm frying pan over a medium heat. Cook the onions and peppers with ½ tsp salt for 12 minutes, until soft and just catching.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Add the garlic, cumin and harissa and cook for 1 minute. Tip in the tomatoes, crush them with a spoon, add the preserved lemon and simmer for 10 minutes.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Make six hollows in the sauce and crack an egg into each. Cover and cook for 6 to 8 minutes, until the whites are set and the yolks still move.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Crumble over the feta, tear over the coriander and bring the pan to the table.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Cooking for more or fewer people?</summary><!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>Ingredient</th><th>Serves 2</th><th>Serves 4</th><th>Serves 6</th></tr></thead><tbody><tr><td>Tinned tomatoes</td><td>400g</td><td>800g</td><td>1.2kg</td></tr><tr><td>Eggs</td><td>3</td><td>6</td><td>9</td></tr><tr><td>Feta</td><td>50g</td><td>100g</td><td>150g</td></tr><tr><td>Pan</td><td>20cm</td><td>28cm</td><td>Two 24cm</td></tr></tbody></table></figure>\n<!-- /wp:table --></details>\n<!-- /wp:details -->\n\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Make ahead and storage</summary><!-- wp:paragraph -->\n<p class=\"\">The sauce keeps for 3 days in the fridge and freezes for 2 months. Reheat it until bubbling before you add the eggs. Cooked eggs don't reheat well.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Swaps that work</summary><!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>No preserved lemon: the zest of a whole lemon and a pinch more salt.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>No harissa: 1 tsp chilli flakes and 1 tsp sweet paprika.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Vegan: leave out the eggs and feta, add a drained tin of butter beans at step 2.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></details>\n<!-- /wp:details --></div>\n<!-- /wp:group -->\n\n<!-- wp:pattern {\"slug\":\"pantry/pan-size-note\"} /-->\n\n<!-- wp:pattern {\"slug\":\"pantry/leftovers\"} /-->\n\n<!-- wp:pattern {\"slug\":\"pantry/ingredient-spotlight\"} /-->\n\n<!-- wp:pattern {\"slug\":\"pantry/reader-notes\"} /-->\n\n<!-- wp:pattern {\"slug\":\"pantry/author-card\"} /-->"
  },
  {
   "title": "Roast cauliflower with turmeric butter and dates",
   "slug": "roast-cauliflower-turmeric",
   "category": "traybakes",
   "tags": [
    "Vegetarian",
    "Gluten-free",
    "Cauliflower"
   ],
   "image": "cauliflower.jpg",
   "excerpt": "50 minutes, serves 4 as a side or 2 as dinner.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">Roast the whole head, leaves and all. The leaves go crisp like crisps and people fight over them.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"anchor\":\"recipe\",\"className\":\"is-style-recipe-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div id=\"recipe\" class=\"wp-block-group is-style-recipe-card\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n<h2 class=\"wp-block-heading has-xx-large-font-size\">Roast cauliflower with turmeric butter and dates</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\",\"textColor\":\"muted\",\"className\":\"no-print\"} -->\n<p class=\"no-print has-muted-color has-text-color has-x-small-font-size\">Print it and the photos and comments drop out.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Serves</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">4</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">10 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Cook</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">40 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Total</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">50 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Ingredients</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-ingredients\"} -->\n<ul class=\"wp-block-list is-style-ingredients\"><!-- wp:list-item -->\n<li><strong>1</strong> large cauliflower, about 1kg</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>60g</strong> butter (4 tbsp)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1 tsp</strong> ground turmeric</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1 tsp</strong> cumin seeds</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>6</strong> Medjool dates, torn</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>30g</strong> toasted almonds (¼ cup)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Parsley and a lemon, to finish</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Method</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true,\"className\":\"is-style-steps\"} -->\n<ol class=\"wp-block-list is-style-steps\"><!-- wp:list-item -->\n<li>Heat the oven to 220°C (200°C fan). Cut the cauliflower into 8 wedges through the stalk, keeping the leaves on.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Melt the butter with the turmeric and cumin. Toss the cauliflower in it with 1 tsp salt and spread on a large tray.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Roast for 30 minutes, turn, add the dates and roast for 10 more.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Scatter over almonds, parsley and a squeeze of lemon.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Make ahead and storage</summary><!-- wp:paragraph -->\n<p class=\"\">Best straight from the oven. Leftovers are good cold the next day, chopped into a grain salad.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details --></div>\n<!-- /wp:group -->"
  },
  {
   "title": "Chickpeas with tomato, cumin and warm flatbread",
   "slug": "chickpeas-tomato-cumin",
   "category": "dinner",
   "tags": [
    "Vegan",
    "Chickpeas",
    "Tins",
    "Under 30 minutes"
   ],
   "image": "chickpea.jpg",
   "excerpt": "25 minutes, serves 4. Two tins and a spice drawer.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">The recipe that the first book was named after, more or less. Mash some of the chickpeas against the side of the pan and the sauce thickens by itself.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"anchor\":\"recipe\",\"className\":\"is-style-recipe-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div id=\"recipe\" class=\"wp-block-group is-style-recipe-card\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n<h2 class=\"wp-block-heading has-xx-large-font-size\">Chickpeas with tomato, cumin and warm flatbread</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\",\"textColor\":\"muted\",\"className\":\"no-print\"} -->\n<p class=\"no-print has-muted-color has-text-color has-x-small-font-size\">Print it and the photos and comments drop out.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Serves</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">4</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">5 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Cook</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">20 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Total</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">25 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Ingredients</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-ingredients\"} -->\n<ul class=\"wp-block-list is-style-ingredients\"><!-- wp:list-item -->\n<li><strong>3 tbsp</strong> olive oil</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1</strong> onion, chopped</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>2 tsp</strong> ground cumin</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1 tsp</strong> smoked paprika</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>2 × 400g</strong> tins chickpeas, drained</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>400g</strong> tinned chopped tomatoes</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>4</strong> flatbreads</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Method</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true,\"className\":\"is-style-steps\"} -->\n<ol class=\"wp-block-list is-style-steps\"><!-- wp:list-item -->\n<li>Soften the onion in the oil for 8 minutes.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Add the spices for 1 minute, then the chickpeas, tomatoes and 150ml water.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Simmer for 10 minutes, mashing a third of the chickpeas as you go.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Warm the flatbreads in a dry pan and serve.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Cooking for more or fewer people?</summary><!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>Ingredient</th><th>Serves 2</th><th>Serves 4</th><th>Serves 6</th></tr></thead><tbody><tr><td>Chickpeas</td><td>1 tin</td><td>2 tins</td><td>3 tins</td></tr><tr><td>Tomatoes</td><td>200g</td><td>400g</td><td>600g</td></tr></tbody></table></figure>\n<!-- /wp:table --></details>\n<!-- /wp:details --></div>\n<!-- /wp:group -->"
  },
  {
   "title": "Hummus with crispy chickpeas and chilli butter",
   "slug": "hummus-chilli-butter",
   "category": "sides",
   "tags": [
    "Vegetarian",
    "Gluten-free",
    "Chickpeas"
   ],
   "image": "hummus.jpg",
   "excerpt": "20 minutes, serves 6 as a starter.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">The trick is ice-cold water and more tahini than feels right. Don't bother peeling the chickpeas.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"anchor\":\"recipe\",\"className\":\"is-style-recipe-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div id=\"recipe\" class=\"wp-block-group is-style-recipe-card\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n<h2 class=\"wp-block-heading has-xx-large-font-size\">Hummus with crispy chickpeas and chilli butter</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\",\"textColor\":\"muted\",\"className\":\"no-print\"} -->\n<p class=\"no-print has-muted-color has-text-color has-x-small-font-size\">Print it and the photos and comments drop out.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Serves</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">6</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">15 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Cook</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">5 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Total</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">20 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Ingredients</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-ingredients\"} -->\n<ul class=\"wp-block-list is-style-ingredients\"><!-- wp:list-item -->\n<li><strong>2 × 400g</strong> tins chickpeas</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>120g</strong> tahini (½ cup)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1</strong> lemon, juiced</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1</strong> small garlic clove</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>4 tbsp</strong> iced water</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>40g</strong> butter</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1 tsp</strong> Aleppo chilli</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Method</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true,\"className\":\"is-style-steps\"} -->\n<ol class=\"wp-block-list is-style-steps\"><!-- wp:list-item -->\n<li>Keep a handful of chickpeas back. Blend the rest with the tahini, lemon, garlic and 1 tsp salt for 2 minutes.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>With the motor running, add the iced water a spoon at a time until pale and smooth.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Fry the reserved chickpeas in the butter until crisp, then add the chilli.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Spread the hummus in a wide bowl and pour the butter over.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:pattern {\"slug\":\"pantry/substitutions\"} /-->"
  },
  {
   "title": "Red lentil soup with lemon and crispy onions",
   "slug": "red-lentil-soup",
   "category": "soups",
   "tags": [
    "Vegan",
    "Gluten-free",
    "Lentils"
   ],
   "image": "lentils.jpg",
   "excerpt": "40 minutes, serves 4. Freezes well.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">My mum's soup, with more lemon than she'd use. The crispy onions are optional but they make it dinner.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"anchor\":\"recipe\",\"className\":\"is-style-recipe-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div id=\"recipe\" class=\"wp-block-group is-style-recipe-card\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n<h2 class=\"wp-block-heading has-xx-large-font-size\">Red lentil soup with lemon and crispy onions</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\",\"textColor\":\"muted\",\"className\":\"no-print\"} -->\n<p class=\"no-print has-muted-color has-text-color has-x-small-font-size\">Print it and the photos and comments drop out.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Serves</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">4</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">10 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Cook</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">30 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Total</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">40 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Ingredients</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-ingredients\"} -->\n<ul class=\"wp-block-list is-style-ingredients\"><!-- wp:list-item -->\n<li><strong>250g</strong> red lentils (1¼ cups)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1</strong> onion, chopped</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1</strong> carrot, grated</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>2 tsp</strong> cumin</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1.2 litres</strong> stock (5 cups)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1</strong> lemon</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>2</strong> onions, sliced, for frying</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Method</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true,\"className\":\"is-style-steps\"} -->\n<ol class=\"wp-block-list is-style-steps\"><!-- wp:list-item -->\n<li>Soften the chopped onion and carrot in oil for 8 minutes.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Add the cumin, lentils and stock. Simmer for 20 minutes until the lentils collapse.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Blend half, stir back in, and season with lemon juice and salt.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Fry the sliced onions slowly until dark and crisp, and pile on top.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Make ahead and storage</summary><!-- wp:paragraph -->\n<p class=\"\">Keeps 4 days in the fridge and 3 months in the freezer. It thickens as it sits, so add water when you reheat.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details --></div>\n<!-- /wp:group -->\n\n<!-- wp:pattern {\"slug\":\"pantry/technique-spices\"} /-->\n\n<!-- wp:pattern {\"slug\":\"pantry/storage-notes\"} /-->"
  },
  {
   "title": "Lemon and olive oil loaf",
   "slug": "lemon-olive-oil-loaf",
   "category": "baking",
   "tags": [
    "Vegetarian",
    "Dairy-free",
    "Lemon",
    "Baking"
   ],
   "image": "cake.jpg",
   "excerpt": "1 hour 5 minutes, makes 10 slices.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">No butter, no mixer. It keeps for a week and gets better on day two.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"anchor\":\"recipe\",\"className\":\"is-style-recipe-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div id=\"recipe\" class=\"wp-block-group is-style-recipe-card\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n<h2 class=\"wp-block-heading has-xx-large-font-size\">Lemon and olive oil loaf</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\",\"textColor\":\"muted\",\"className\":\"no-print\"} -->\n<p class=\"no-print has-muted-color has-text-color has-x-small-font-size\">Print it and the photos and comments drop out.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Makes</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">10 slices</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">15 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Bake</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">50 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Total</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">1 hr 5 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Ingredients</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-ingredients\"} -->\n<ul class=\"wp-block-list is-style-ingredients\"><!-- wp:list-item -->\n<li><strong>250g</strong> plain flour (2 cups)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>2 tsp</strong> baking powder</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>200g</strong> caster sugar (1 cup)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>3</strong> eggs</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>150ml</strong> olive oil (⅔ cup)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>2</strong> lemons, zest and juice</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Method</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true,\"className\":\"is-style-steps\"} -->\n<ol class=\"wp-block-list is-style-steps\"><!-- wp:list-item -->\n<li>Heat the oven to 180°C (160°C fan, 350°F). Line a 900g loaf tin.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Whisk the sugar, eggs and zest for 2 minutes, then whisk in the oil.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Fold in the flour, baking powder and a pinch of salt.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Bake for 50 minutes, until a skewer comes out clean. Pour over the lemon juice while it's hot.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:pattern {\"slug\":\"pantry/diet-labels\"} /-->\n\n<!-- wp:pattern {\"slug\":\"pantry/author-card\"} /-->"
  },
  {
   "title": "Saffron rice with a crust",
   "slug": "saffron-rice-crust",
   "category": "sides",
   "tags": [
    "Gluten-free",
    "Vegetarian",
    "Rice",
    "Weekend"
   ],
   "image": "rice.jpg",
   "excerpt": "2 hours, mostly waiting. Serves 6.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">The weekend project. The crust on the bottom is the point, and it comes out in one piece if you're brave with the flip.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"anchor\":\"recipe\",\"className\":\"is-style-recipe-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div id=\"recipe\" class=\"wp-block-group is-style-recipe-card\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n<h2 class=\"wp-block-heading has-xx-large-font-size\">Saffron rice with a crust</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\",\"textColor\":\"muted\",\"className\":\"no-print\"} -->\n<p class=\"no-print has-muted-color has-text-color has-x-small-font-size\">Print it and the photos and comments drop out.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Serves</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">6</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">20 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Cook</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">1 hr 40 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Total</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">2 hr</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Ingredients</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-ingredients\"} -->\n<ul class=\"wp-block-list is-style-ingredients\"><!-- wp:list-item -->\n<li><strong>400g</strong> basmati rice (2 cups)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>½ tsp</strong> saffron threads</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>60g</strong> butter</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>3 tbsp</strong> yoghurt</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>40g</strong> barberries or cranberries</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Method</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true,\"className\":\"is-style-steps\"} -->\n<ol class=\"wp-block-list is-style-steps\"><!-- wp:list-item -->\n<li>Soak the rice for 1 hour. Steep the saffron in 4 tbsp hot water.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Boil the rice for 6 minutes in well-salted water and drain.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Mix a third of the rice with the yoghurt and half the saffron and press into a buttered non-stick pan.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Pile in the rest, poke holes, add the butter, cover tightly and cook on low for 45 minutes. Flip onto a plate.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:pattern {\"slug\":\"pantry/method-with-photos\"} /-->\n\n<!-- wp:pattern {\"slug\":\"pantry/author-card\"} /-->"
  },
  {
   "title": "Aubergine with miso and tomato",
   "slug": "aubergine-miso-tomato",
   "category": "traybakes",
   "tags": [
    "Vegan",
    "Aubergine"
   ],
   "image": "aubergine.jpg",
   "excerpt": "45 minutes, serves 4.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">Salty, sweet and soft all the way through. Score the aubergine deeply so the miso gets in.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"anchor\":\"recipe\",\"className\":\"is-style-recipe-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div id=\"recipe\" class=\"wp-block-group is-style-recipe-card\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n<h2 class=\"wp-block-heading has-xx-large-font-size\">Aubergine with miso and tomato</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\",\"textColor\":\"muted\",\"className\":\"no-print\"} -->\n<p class=\"no-print has-muted-color has-text-color has-x-small-font-size\">Print it and the photos and comments drop out.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"9rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Serves</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">4</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Prep</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">10 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Cook</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">35 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-facts\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|10\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-facts\"><!-- wp:paragraph -->\n<p class=\"\">Total</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">45 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Ingredients</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-ingredients\"} -->\n<ul class=\"wp-block-list is-style-ingredients\"><!-- wp:list-item -->\n<li><strong>3</strong> aubergines</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>3 tbsp</strong> white miso</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>1 tbsp</strong> maple syrup</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>4 tbsp</strong> olive oil</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><strong>300g</strong> cherry tomatoes</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Method</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true,\"className\":\"is-style-steps\"} -->\n<ol class=\"wp-block-list is-style-steps\"><!-- wp:list-item -->\n<li>Heat the oven to 220°C (200°C fan). Halve the aubergines and score the flesh in a criss-cross.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Mix the miso, maple syrup and oil and brush it over.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Roast cut side up for 25 minutes, add the tomatoes and roast for 10 more.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->"
  },
