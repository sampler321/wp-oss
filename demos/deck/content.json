 "posts": [
  {
   "title": "Nia Campbell, Brighton part",
   "category": "videos",
   "image": "stairs.jpg",
   "excerpt": "Four minutes, filmed over one summer between the Level and the seafront. Nia wanted every trick on a spot you can reach by bus from the.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">Four minutes, filmed over one summer between the Level and the seafront. Nia wanted every trick on a spot you can reach by bus from the shop, and she got close.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The ender took two sessions. The first try went through a hedge. The second is in the part.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Credits</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rows\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-rows\"><!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Filmed</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Jonny Kerr, VX1000 and a phone</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Edited</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Jonny Kerr</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Music</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Two tracks by a Brighton band, with permission</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Length</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">4 min 12 s</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Premiere</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Coping, Thursday 23 October, 7pm</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:pattern {\"slug\":\"deck/video-stills\"} /-->\n\n<!-- wp:pattern {\"slug\":\"deck/video-night\"} /-->"
  },
  {
   "title": "Jonny Kerr at Hove Lagoon, raw files",
   "category": "videos",
   "image": "venice-grind.jpg",
   "excerpt": "Twelve minutes of unedited bowl runs, slams included. No music, just wheels on concrete and the odd.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">Twelve minutes of unedited bowl runs, slams included. No music, just wheels on concrete and the odd gull.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Filmed over three mornings at 7am, before the scooters wake up.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Credits</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rows\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-rows\"><!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Filmed</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Sol Rivera, from the deck of the bowl</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Edited</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Not really</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Length</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">12 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Spot</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Hove Lagoon bowl</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:pattern {\"slug\":\"deck/video-tracklist\"} /-->\n\n<!-- wp:pattern {\"slug\":\"deck/video-night\"} /-->"
  },
  {
   "title": "Couch session with Aisha",
   "category": "videos",
   "image": "couch-ollie.jpg",
   "excerpt": "Aisha filmed a whole part in her flat during the rain in March. Manuals down the hall, ollies over the sofa, a kickflip into the kitchen.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">Aisha filmed a whole part in her flat during the rain in March. Manuals down the hall, ollies over the sofa, a kickflip into the kitchen that her landlord has not seen.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The couch did not survive. The part did.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Credits</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rows\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-rows\"><!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Filmed</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Aisha Brown and her flatmate Remi</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Music</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Remi, on a keyboard from a charity shop</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Length</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">2 min 40 s</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Spot</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">A flat in Moulsecoomb</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:pattern {\"slug\":\"deck/video-stills\"} /-->\n\n<!-- wp:pattern {\"slug\":\"deck/video-night\"} /-->"
  },
  {
   "title": "Pushing to Shoreham and back",
   "category": "videos",
   "image": "road.jpg",
   "excerpt": "Sol pushed a cruiser along the coast road to Shoreham and back, 14 miles. We filmed from a bike. It took most of a Sunday and two stops for.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">Sol pushed a cruiser along the coast road to Shoreham and back, 14 miles. We filmed from a bike. It took most of a Sunday and two stops for chips.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">If you want to try it, go west in the morning so the wind is behind you on the way home.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Credits</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rows\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-rows\"><!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Filmed</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Jonny Kerr, from a borrowed bike</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Board</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Cruiser, 36in, 65mm 78a wheels</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Distance</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">14 miles</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"8rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Length</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">6 min</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:pattern {\"slug\":\"deck/video-tracklist\"} /-->\n\n<!-- wp:pattern {\"slug\":\"deck/video-night\"} /-->"
  },
