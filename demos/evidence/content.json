   "title": "The last bus to Hessle",
   "slug": "the-last-bus-to-hessle",
   "category": "the-ferry-inn",
   "image": "bridge.jpg",
   "excerpt": "Carol left the Ferry Inn at 10.40pm. Where did she go? A retired bus driver helps us check the timetable.",
   "date": "2026-01-05",
   "content": "<!-- wp:group {\"className\":\"is-style-file-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group is-style-file-card\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Case file</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\"><strong>Case</strong> The Ferry Inn</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\"><strong>Part</strong> 2 of 5</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\"><strong>Released</strong> Monday 5 January 2026</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\"><strong>Length</strong> 49 minutes</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:audio -->\n<figure class=\"wp-block-audio\"><audio controls src=\"https://upload.wikimedia.org/wikipedia/commons/a/a7/Trialofsusanbanthony_18_anonymous_128kb.ogg\"></audio><figcaption class=\"wp-element-caption\">Stand-in audio: a LibriVox reading from “An Account of the Proceedings on the Trial of Susan B. Anthony” (CC0, Wikimedia Commons). Replace with your episode file.</figcaption></figure>\n<!-- /wp:audio -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Chapters</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-chapters\"} -->\n<ul class=\"wp-block-list is-style-chapters\"><!-- wp:list-item -->\n<li><a href=\"https://upload.wikimedia.org/wikipedia/commons/a/a7/Trialofsusanbanthony_18_anonymous_128kb.ogg#t=0\">00:00</a> Previously</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://upload.wikimedia.org/wikipedia/commons/a/a7/Trialofsusanbanthony_18_anonymous_128kb.ogg#t=330\">05:30</a> The 350</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://upload.wikimedia.org/wikipedia/commons/a/a7/Trialofsusanbanthony_18_anonymous_128kb.ogg#t=1210\">20:10</a> The driver who called in</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://upload.wikimedia.org/wikipedia/commons/a/a7/Trialofsusanbanthony_18_anonymous_128kb.ogg#t=2120\">35:20</a> The footpath by the bridge</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Sources</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true,\"className\":\"is-style-sources\"} -->\n<ol class=\"wp-block-list is-style-sources\"><!-- wp:list-item -->\n<li>East Yorkshire Motor Services timetable, winter 1987, Hull History Centre.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Interview with Ray Halliday, retired bus driver, recorded October 2025.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Transcript</h3>\n<!-- /wp:heading -->\n\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Read the transcript</summary><!-- wp:paragraph -->\n<p class=\"\"><strong>Ray</strong> The 350 went at 10.52 from the Square. If she was on it, I’d have seen her. I wasn’t driving it that night, though.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"fontSize\":\"x-small\"} -->\n<p class=\"has-x-small-font-size\">Typed by Dev and checked against the audio.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">If this episode affected you</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"small\"} -->\n<p class=\"has-small-font-size\">Samaritans: 116 123, any time. Victim Support: 08 08 16 89 111.</p>\n<!-- /wp:paragraph -->"
  }
