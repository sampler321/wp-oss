   "content": "<!-- wp:paragraph {\"className\":\"is-style-tabs\"} -->\n<p class=\"is-style-tabs\"><a href=\"#gallery\">Gallery</a> / <a href=\"#info\">Info</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-sheet\",\"align\":\"wide\",\"anchor\":\"gallery\",\"layout\":{\"type\":\"grid\",\"columnCount\":2,\"minimumColumnWidth\":\"14rem\"}} -->\n<div id=\"gallery\" class=\"wp-block-group alignwide is-style-sheet\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/knot-41.jpg' ) ); ?>\" alt=\"Knot, 2025: a pen drawing on off-white paper\"/><figcaption class=\"wp-element-caption\">Knot</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"anchor\":\"info\",\"className\":\"is-style-rule-top\",\"layout\":{\"type\":\"constrained\"}} -->\n<div id=\"info\" class=\"wp-block-group is-style-rule-top\"><!-- wp:heading {\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading has-x-large-font-size\">Info</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Two pendulums drag one pen across the paper. The code decides the starting swing and the friction, the machine does the rest. It is a harmonograph with a laptop attached.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-rule-bottom\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\",\"padding\":{\"bottom\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-bottom\" style=\"padding-bottom:var(--wp--preset--spacing--20)\"><!-- wp:paragraph {\"textColor\":\"muted\"} -->\n<p class=\"has-muted-color has-text-color\">Edition</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">40 drawings</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-bottom\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\",\"padding\":{\"bottom\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-bottom\" style=\"padding-bottom:var(--wp--preset--spacing--20)\"><!-- wp:paragraph {\"textColor\":\"muted\"} -->\n<p class=\"has-muted-color has-text-color\">Size</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">40 × 40 cm</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-bottom\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\",\"padding\":{\"bottom\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-bottom\" style=\"padding-bottom:var(--wp--preset--spacing--20)\"><!-- wp:paragraph {\"textColor\":\"muted\"} -->\n<p class=\"has-muted-color has-text-color\">Machine</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Built from two bicycle wheels and a kitchen scale</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-bottom\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\",\"padding\":{\"bottom\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-bottom\" style=\"padding-bottom:var(--wp--preset--spacing--20)\"><!-- wp:paragraph {\"textColor\":\"muted\"} -->\n<p class=\"has-muted-color has-text-color\">Shown at</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Sala Bonjardim, Porto, November 2025</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
