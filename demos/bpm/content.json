  {
   "title": "Szum 053, the long one",
   "category": "szum",
   "tags": [
    "Ambient",
    "Dub"
   ],
   "image": "crowd.jpg",
   "template": "single-mix",
   "excerpt": "The station ran an all-night fundraiser and I took the 1am to 5am slot.",
   "content": "<!-- wp:embed {\"url\":\"https://www.mixcloud.com/radiowola/szum-053/\",\"type\":\"rich\",\"providerNameSlug\":\"mixcloud\",\"responsive\":true} -->\n<figure class=\"wp-block-embed is-type-rich is-provider-mixcloud wp-block-embed-mixcloud\"><div class=\"wp-block-embed__wrapper\">\nhttps://www.mixcloud.com/radiowola/szum-053/\n</div></figure>\n<!-- /wp:embed -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Radio Wola's spring fundraiser ran all night and I took 1am to 5am. We raised 14,200 zł for the new transmitter. This is the whole four hours.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table {\"className\":\"is-style-dates\"} -->\n<figure class=\"wp-block-table is-style-dates\"><table class=\"has-fixed-layout\"><tbody><tr><td>Broadcast</td><td>Radio Wola 98.4 FM, fundraiser night, 4 April, 01:00 Warsaw time</td></tr><tr><td>Length</td><td>4 hours</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Tracklist</h3>\n<!-- /wp:heading -->\n\n<!-- wp:table {\"className\":\"is-style-tracklist\"} -->\n<figure class=\"wp-block-table is-style-tracklist\"><table class=\"has-fixed-layout\"><thead><tr><th>Time</th><th>Artist</th><th>Title</th></tr></thead><tbody><tr><td>00:00</td><td>The Orb</td><td>Blue Room</td></tr><tr><td>17:00</td><td>Basic Channel</td><td>Q-Loop</td></tr><tr><td>33:30</td><td>Grouper</td><td>Heavy Water</td></tr></tbody></table></figure>\n<!-- /wp:table -->"
