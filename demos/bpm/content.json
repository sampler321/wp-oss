   "content": "<!-- wp:embed {\"url\":\"https://www.mixcloud.com/radiowola/dzwieki-miasta/\",\"type\":\"rich\",\"providerNameSlug\":\"mixcloud\",\"responsive\":true} -->\n<figure class=\"wp-block-embed is-type-rich is-provider-mixcloud wp-block-embed-mixcloud\"><div class=\"wp-block-embed__wrapper\">\nhttps://www.mixcloud.com/radiowola/dzwieki-miasta/\n</div></figure>\n<!-- /wp:embed -->\n\n<!-- wp:paragraph -->\n<p class=\"\">One hour for the Dźwięki Miasta podcast. Every record is from the Polskie Nagrania library series, bought at the Koło flea market over about six years.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table {\"className\":\"is-style-dates\"} -->\n<figure class=\"wp-block-table is-style-dates\"><table class=\"has-fixed-layout\"><tbody><tr><td>Broadcast</td><td>Dźwięki Miasta podcast, episode 112</td></tr><tr><td>Length</td><td>59 minutes</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Tracklist</h3>\n<!-- /wp:heading -->\n\n<!-- wp:table {\"className\":\"is-style-tracklist\"} -->\n<figure class=\"wp-block-table is-style-tracklist\"><table class=\"has-fixed-layout\"><thead><tr><th>Time</th><th>Artist</th><th>Title</th></tr></thead><tbody><tr><td>00:00</td><td>Andrzej Korzyński</td><td>Dziewczyny, bądźcie ładne</td></tr><tr><td>08:15</td><td>Czesław Niemen</td><td>Kwiaty ojczyste</td></tr><tr><td>15:40</td><td>Novi Singers</td><td>Torpeda</td></tr></tbody></table></figure>\n<!-- /wp:table -->"
