   "image": "school-faces.jpg",
   "template": "single-mural",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Five laughing faces made from 4,000 mosaic dots. Year 5 painted the dots, I did the drawing and the edges.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-rule-top\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\",\"padding\":{\"top\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-top\" style=\"padding-top:var(--wp--preset--spacing--20)\"><!-- wp:paragraph {\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"700\"}}} -->\n<p class=\"has-small-font-size\">Where</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Courtyard, Colegio Maravillas, Málaga</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-top\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\",\"padding\":{\"top\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-top\" style=\"padding-top:var(--wp--preset--spacing--20)\"><!-- wp:paragraph {\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"700\"}}} -->\n<p class=\"has-small-font-size\">Commissioned by</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The school parents' association</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-top\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\",\"padding\":{\"top\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyCont