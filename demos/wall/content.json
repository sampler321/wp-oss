roup is-style-rule-top\" style=\"padding-top:var(--wp--preset--spacing--20)\"><!-- wp:paragraph {\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"700\"}}} -->\n<p class=\"has-small-font-size\">Year</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">2021</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-top\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\",\"padding\":{\"top\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-top\" style=\"padding-top:var(--wp--preset--spacing--20)\"><!-- wp:paragraph {\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"700\"}}} -->\n<p class=\"has-small-font-size\">Wall</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">3 × 6 m</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-top\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\",\"padding\":{\"top\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-top\" style=\"padding-top:var(--wp--preset--spacing--20)\"><!-- wp:paragraph {\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"700\"}}} -->\n<p class=\"has-small-font-size\">Status</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Gone. Building demolished in 2023</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
