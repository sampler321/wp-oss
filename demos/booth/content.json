  {
   "title": "Mixing Doki for Mała Orkiestra Portowa",
   "category": "sessions",
   "image": "band.jpg",
   "excerpt": "Eleven songs mixed in Studio B through the X-Desk, with a half-inch copy for the vinyl cut.",
   "content": "<!-- wp:paragraph -->\n<p class=\"\">The band recorded at home and brought us 11 songs to mix. Iga ran everything through the X-Desk and printed a half-inch copy on the Otari for the vinyl master.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td>Room</td><td>Studio B</td></tr><tr><td>Days</td><td>6</td></tr><tr><td>Engineer</td><td>Iga Dąbrowska</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n\n<!-- wp:gallery {\"columns\":2,\"linkTo\":\"none\"} -->\n<figure class=\"wp-block-gallery has-nested-images columns-2 is-cropped\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/band.jpg' ) ); ?>\" alt=\"Photo from the session: Mixing Doki for Mała Orkiestra Portowa\"/><figcaption class=\"wp-element-caption\">On the day</figcaption></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/console.jpg' ) ); ?>\" alt=\"The Studio A control room\"/><figcaption class=\"wp-element-caption\">In the control room</figcaption></figure>\n<!-- /wp:image --></figure>\n<!-- /wp:gallery -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">We booked four days and finished in three. We used the fourth to play pool.</p>\n<!-- /wp:paragraph --><cite>From the band, afterwards</cite></blockquote>\n<!-- /wp:quote -->"
