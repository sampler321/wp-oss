  {
   "title": "Rocking chair, cherry",
   "category": "chairs",
   "image": "chair.jpg",
   "excerpt": "A Shaker-pattern rocker with a woven tape seat.",
   "date": "2026-07-18",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Kofi drew it full size on a sheet of plywood first, rockers included, because a rocker that is a few degrees off tips you out or rocks you to sleep too fast.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Timber</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Cherry from a sawmill near Gent</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Seat</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Cotton tape, woven in the workshop</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Finish</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Hardwax oil</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">5 weeks</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Price</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">€2,300</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Cut list</h4>\n<!-- /wp:heading -->\n\n<!-- wp:table {\"className\":\"is-style-paper\"} -->\n<figure class=\"wp-block-table is-style-paper\"><table class=\"has-fixed-layout\"><thead><tr><th>Part</th><th>No.</th><th>Timber</th><th>Finished size (mm)</th></tr></thead><tbody><tr><td>Rockers</td><td>2</td><td>Cherry</td><td>820 × 110 × 28</td></tr><tr><td>Back posts</td><td>2</td><td>Cherry</td><td>1080 × 38 × 38</td></tr><tr><td>Slats</td><td>3</td><td>Cherry</td><td>390 × 70 × 9</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">In the workshop</h4>\n<!-- /wp:heading -->\n\n<!-- wp:gallery {\"columns\":3,\"linkTo\":\"none\"} -->\n<figure class=\"wp-block-gallery has-nested-images columns-3 is-cropped\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/shavings.jpg' ) ); ?>\" alt=\"A hand plane among curled shavings\"/><figcaption class=\"wp-element-caption\">Planed by hand</figcaption></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/clamps.jpg' ) ); ?>\" alt=\"Clamps holding a glued frame\"/><figcaption class=\"wp-element-caption\">Glue-up</figcaption></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/timber.jpg' ) ); ?>\" alt=\"Boards stacked with spacers in a yard\"/><figcaption class=\"wp-element-caption\">The boards before</figcaption></figure>\n<!-- /wp:image --></figure>\n<!-- /wp:gallery -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/commissions/\">Ask about a piece like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
  },
  {
   "title": "Joined chest, after a 1670s original",
   "category": "cabinets-and-chests",
   "image": "chest.jpg",
   "excerpt": "A copy of a carved oak chest the client saw in a museum.",
   "date": "2026-05-30",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">The client fell for a 17th-century chest from Ipswich, Massachusetts, in a museum and asked whether it could be made again. It could, slowly: the carving alone took Sanne four weeks. The photo shows the original.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Timber</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Riven oak from a single Achterhoek log</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Joints</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Mortise and tenon, pegged, no glue</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Finish</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Linseed oil and wax</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">12 weeks</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Price</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">€7,800</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Cut list</h4>\n<!-- /wp:heading -->\n\n<!-- wp:table {\"className\":\"is-style-paper\"} -->\n<figure class=\"wp-block-table is-style-paper\"><table class=\"has-fixed-layout\"><thead><tr><th>Part</th><th>No.</th><th>Timber</th><th>Finished size (mm)</th></tr></thead><tbody><tr><td>Stiles</td><td>4</td><td>Oak, riven</td><td>760 × 90 × 45</td></tr><tr><td>Rails</td><td>6</td><td>Oak</td><td>1150 × 100 × 28</td></tr><tr><td>Panels</td><td>6</td><td>Oak, riven</td><td>360 × 280 × 15</td></tr><tr><td>Lid boards</td><td>2</td><td>Oak</td><td>1250 × 270 × 20</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">In the workshop</h4>\n<!-- /wp:heading -->\n\n<!-- wp:gallery {\"columns\":3,\"linkTo\":\"none\"} -->\n<figure class=\"wp-block-gallery has-nested-images columns-3 is-cropped\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/shavings.jpg' ) ); ?>\" alt=\"A hand plane among curled shavings\"/><figcaption class=\"wp-element-caption\">Planed by hand</figcaption></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/clamps.jpg' ) ); ?>\" alt=\"Clamps holding a glued frame\"/><figcaption class=\"wp-element-caption\">Glue-up</figcaption></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/timber.jpg' ) ); ?>\" alt=\"Boards stacked with spacers in a yard\"/><figcaption class=\"wp-element-caption\">The boards before</figcaption></figure>\n<!-- /wp:image --></figure>\n<!-- /wp:gallery -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/commissions/\">Ask about a piece like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
  },
  {
   "title": "Piano stool, rebuilt",
   "category": "repairs",
   "image": "stool.jpg",
   "excerpt": "A 1900s adjustable piano stool with a split top and a stripped thread.",
   "date": "2026-04-12",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">We take in one or two repairs a season, when the piece deserves it. This one needed a new walnut top glued up from three boards and a new wooden screw cut on the lathe.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Work</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">New top, new screw thread, legs reglued</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Timber</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Walnut for the top</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Finish</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Shellac, as the original</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Price</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">€480</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
  },
  {
   "title": "A glue-up, in pictures",
   "category": "workshop-notes",
   "image": "clamps.jpg",
   "excerpt": "Twelve clamps, a timer and ten minutes before the glue skins over.",
   "date": "2026-03-20",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Gluing up a door frame or a table top is the one part of the job where nobody talks. Everything is dry-fitted twice, clamps are set to width, and then it is ten minutes of work and a day of waiting.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Glue</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Hide glue for chairs, so they can be taken apart; PVA for tops</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Clamps</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">We own 64 and it is never enough</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
  },
  {
   "title": "The cupboard in Nuremberg",
   "category": "workshop-notes",
   "image": "cabinet.jpg",
   "excerpt": "A study trip to look at an ash and oak cupboard from about 1600.",
   "date": "2026-02-02",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Sanne spent two days in the Fembohaus in Nuremberg drawing this cupboard. The panels float in their frames exactly as ours do. Four hundred years later, none of them has split.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Where</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Stadtmuseum Fembohaus, Nuremberg</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Date of the cupboard</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">About 1600</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Timber</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Ash and oak</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
  },
  {
   "title": "Buying elm on the IJssel",
   "category": "workshop-notes",
   "image": "timber.jpg",
   "excerpt": "How a diseased tree becomes a chair seat, and why it takes three years.",
   "date": "2026-01-10",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Every winter the council fells the elms that died of Dutch elm disease over the summer. We buy the best butts, have them milled at a sawmill in Voorst and stack the boards in the shed. The photo is a much bigger yard, a century ago.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Bought this winter</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">4 logs, about 6 cubic metres</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Ready to use</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Winter 2029</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
  },
  {
   "title": "Why we still cut dovetails by hand",
   "category": "workshop-notes",
   "image": "shavings.jpg",
   "excerpt": "A router is faster. We use one for grooves. Drawers get hand-cut dovetails.",
   "date": "2025-11-15",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">A hand-cut dovetail can be spaced to suit the drawer, and the pins can be as thin as a pencil line. It takes Sanne about 40 minutes a corner. We think drawers are the one place people really look.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time per drawer</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">About three hours, four corners</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Tools</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">A dovetail saw, chisels, a marking gauge and a block plane</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
  }
 ],
