   "title": "Six ladder-back chairs, ash and rush",
   "category": "chairs",
   "image": "chair2.jpg",
   "excerpt": "For a kitchen table in Deventer. Steam-bent back legs, hand-woven rush seats.",
   "date": "2026-09-05",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">The drawing we worked from, a 1937 study of a country ladder-back, belongs to the owner's grandmother. We kept the proportions and made the back slats a little wider for modern backs.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-specs\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-specs\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Timber</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Ash from a dieback felling near Lochem</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Seat</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Rush, woven by Hanneke Vos in Epe</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Finish</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Linseed oil</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">3 weeks a chair</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p class=\"\">Price</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">€1,150 each</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Cut list</h4>\n<!-- /wp:heading -->\n\n<!-- wp:table {\"className\":\"is-style-paper\"} -->\n<figure class=\"wp-block-table is-style-paper\"><table class=\"has-fixed-layout\"><thead><tr><th>Part</th><th>No.</th><th>Timber</th><th>Finished size (mm)</th></tr></thead><tbody><tr><td>Back legs, steam-bent</td><td>2</td><td>Ash</td><td>1020 × 38 × 38</td></tr><tr><td>Front legs</td><td>2</td><td>Ash</td><td>450 × 38 × 38</td></tr><tr><td>Back slats</td><td>4</td><td>Ash</td><td>400 × 60 × 10</td></tr><tr><td>Stretchers</td><td>8</td><td>Ash</td><td>420 × 22 dia.</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">In the workshop</h4>\n<!-- /wp:heading -->\n\n<!-- wp:gallery {\"columns\":3,\"linkTo\":\"none\"} -->\n<figure class=\"wp-block-gallery has-nested-images columns-3 is-cropped\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/shavings.jpg' ) ); ?>\" alt=\"A hand plane among curled shavings\"/><figcaption class=\"wp-element-caption\">Planed by hand</figcaption></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/clamps.jpg' ) ); ?>\" alt=\"Clamps holding a glued frame\"/><figcaption class=\"wp-element-caption\">Glue-up</figcaption></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/timber.jpg' ) ); ?>\" alt=\"Boards stacked with spacers in a yard\"/><figcaption class=\"wp-element-caption\">The boards before</figcaption></figure>\n<!-- /wp:image --></figure>\n<!-- /wp:gallery -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/commissions/\">Ask about a piece like this</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->"
