 "posts": [
  {
   "title": "Sermons, Venice 1492: rebacked in calf",
   "category": "conservation",
   "image": "restored.jpg",
   "date": "2025-09-12",
   "excerpt": "The parish in Nowy Sącz brought this in a shopping bag. Both joints had gone and the spine leather came off in three pieces.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\"} -->\n<div class=\"wp-block-columns is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/damaged.jpg\" alt=\"Worn brown calf binding with a split spine and rubbed corners, a ruler along the edge\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/restored.jpg\" alt=\"Brown calf binding with tooled borders and a sound spine, photographed flat with a ruler below\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The parish in Nowy Sącz brought this in a shopping bag. Both joints had gone and the spine leather came off in three pieces.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">We lifted the old spine, lined the joints with Japanese tissue and put on a new spine in dyed calf. The old leather went back on top. The boards, clasps and shelf label are original.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">We did not clean the text block. The staining is 500 years old and tells you where people held it.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>Case note</th><th></th></tr></thead><tbody><tr><td>Structure</td><td>Sewn on five raised cords</td></tr><tr><td>Covering</td><td>Original calf, new calf spine</td></tr><tr><td>Adhesive</td><td>Wheat starch paste</td></tr><tr><td>Size</td><td>21 × 15 × 4 cm</td></tr><tr><td>Hours</td><td>31</td></tr></tbody></table></figure>\n<!-- /wp:table -->"
  },
  {
   "title": "A thesis in navy buckram, 42 copies",
   "category": "theses",
   "image": "thesis.jpg",
   "date": "2025-06-20",
   "excerpt": "Forty-two hard-case theses for the Faculty of Chemistry, all in LB-120 navy with gold on the spine. The faculty wants the surname first, so we set it that way.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\"} -->\n<div class=\"wp-block-columns is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/shelf.jpg\" alt=\"Title page of a 19th-century book of poems, yellowed, open flat\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/thesis.jpg\" alt=\"Decorated 19th-century cloth binding with gilt lettering and a lily on the front\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Forty-two hard-case theses for the Faculty of Chemistry, all in LB-120 navy with gold on the spine. The faculty wants the surname first, so we set it that way.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The PDFs came in on a Monday and the copies went out on Thursday. In June that is about as fast as we go.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>Case note</th><th></th></tr></thead><tbody><tr><td>Binding</td><td>Hard case, sewn</td></tr><tr><td>Cloth</td><td>LB-120 library buckram, navy</td></tr><tr><td>Lettering</td><td>Gold foil, spine and front</td></tr><tr><td>Copies</td><td>42</td></tr><tr><td>Turnaround</td><td>3 working days</td></tr></tbody></table></figure>\n<!-- /wp:table -->"
  },
  {
   "title": "A clamshell box for a family prayer book",
   "category": "boxes",
   "image": "boards.jpg",
   "date": "2025-03-18",
   "excerpt": "Ewa wanted the prayer book rebound. We talked her out of it. The binding is weak but complete, and a new one would have thrown away the old repairs her grandfather made with shoe leather.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\"} -->\n<div class=\"wp-block-columns is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/boards.jpg\" alt=\"Dark leather-covered book with a torn and replaced corner patch\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/sewing.jpg\" alt=\"Brown leather binding with brass clasps resting on a light wooden table\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Ewa wanted the prayer book rebound. We talked her out of it. The binding is weak but complete, and a new one would have thrown away the old repairs her grandfather made with shoe leather.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Instead we made a clamshell box in AS-311 bottle green, lined with felt, with her grandfather's name stamped on the spine label.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>Case note</th><th></th></tr></thead><tbody><tr><td>Box</td><td>Clamshell, two trays</td></tr><tr><td>Cloth</td><td>AS-311 Asahi, bottle green</td></tr><tr><td>Lining</td><td>Grey felt</td></tr><tr><td>Label</td><td>Goatskin, gold-stamped</td></tr><tr><td>Price</td><td>340 zł</td></tr></tbody></table></figure>\n<!-- /wp:table -->"
  },
  {
   "title": "A 1730 map of Europe, flattened and mended along the folds",
   "category": "conservation",
   "image": "map.jpg",
   "date": "2024-11-04",
   "excerpt": "Folded into sixteenths for about two hundred years, so every fold had split. We humidified it, flattened it between felts for a week and mended each fold from the back with thin kozo tissue.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\"} -->\n<div class=\"wp-block-columns is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/map.jpg\" alt=\"Hand-coloured 1730 map of Europe with a decorative border and text panels on either side\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/map.jpg\" alt=\"The same map after flattening, with the fold lines repaired\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Folded into sixteenths for about two hundred years, so every fold had split. We humidified it, flattened it between felts for a week and mended each fold from the back with thin kozo tissue.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">It now lives flat in a folder of unbuffered card, which the owner has promised to keep in a drawer and not on the wall.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>Case note</th><th></th></tr></thead><tbody><tr><td>Object</td><td>Engraved map, hand-coloured</td></tr><tr><td>Repair</td><td>Kozo tissue, wheat starch paste</td></tr><tr><td>Housing</td><td>Folder, unbuffered card</td></tr><tr><td>Size</td><td>62 × 48 cm</td></tr><tr><td>Hours</td><td>14</td></tr></tbody></table></figure>\n<!-- /wp:table -->"
  },
  {
   "title": "Red rot on a set of law reports",
   "category": "conservation",
   "image": "damaged.jpg",
   "date": "2024-09-15",
   "excerpt": "Twenty-two volumes from a law office on Grodzka. The leather came off as orange dust on every hand that touched it.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\"} -->\n<div class=\"wp-block-columns is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/damaged.jpg\" alt=\"Brown calf binding with powdery, rubbed leather and worn corners\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/leather.jpg\" alt=\"Pale tooled leather binding after consolidation, surface stable\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Twenty-two volumes from a law office on Grodzka. The leather came off as orange dust on every hand that touched it.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">We consolidated each volume with Klucel G in ethanol. It does not make the leather look new, and we said so in the estimate. It makes it stop crumbling.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>Case note</th><th></th></tr></thead><tbody><tr><td>Volumes</td><td>22</td></tr><tr><td>Treatment</td><td>Klucel G, 2% in ethanol</td></tr><tr><td>Time per volume</td><td>about 40 minutes</td></tr><tr><td>Price</td><td>180 zł per volume</td></tr></tbody></table></figure>\n<!-- /wp:table -->"
  },
  {
   "title": "A small edition of poems in quarter goatskin",
   "category": "bindings",
   "image": "leather.jpg",
   "date": "2024-06-02",
   "excerpt": "Wydawnictwo Pod Wiatr printed 26 copies of Marta Nowicka's poems by letterpress and brought us the folded sheets.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\"} -->\n<div class=\"wp-block-columns is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/tools.jpg\" alt=\"Catalogue page of brass finishing tools and ornaments\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/leather.jpg\" alt=\"Blind-tooled pale leather binding with an interlaced panel\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Wydawnictwo Pod Wiatr printed 26 copies of Marta Nowicka's poems by letterpress and brought us the folded sheets.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">We sewed them on tapes and bound them in quarter tan goatskin with ochre Asahi sides. Ochre is AS-204, which the mill no longer makes, so we used half of our last roll.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>Case note</th><th></th></tr></thead><tbody><tr><td>Copies</td><td>26, numbered</td></tr><tr><td>Binding</td><td>Quarter leather</td></tr><tr><td>Materials</td><td>HG-07 goatskin, AS-204 cloth</td></tr><tr><td>Tooling</td><td>Gold, spine only</td></tr><tr><td>Trade terms</td><td>25% off</td></tr></tbody></table></figure>\n<!-- /wp:table -->"
  },
  {
   "title": "Gold tooling a spine to match its neighbours",
   "category": "bindings",
   "image": "gilding.jpg",
   "date": "2024-02-10",
   "excerpt": "One volume of a twelve-volume set had lost its spine in a flood. The owner wanted it to sit on the shelf without anyone noticing.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\"} -->\n<div class=\"wp-block-columns is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/shelf.jpg\" alt=\"Title page of a worn 19th-century book\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/gilding.jpg\" alt=\"Narrow leather spine with gold-tooled small flowers\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">One volume of a twelve-volume set had lost its spine in a flood. The owner wanted it to sit on the shelf without anyone noticing.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Tomasz matched the flower tool from our drawer of old finishing tools and tooled the new spine in 23-carat gold leaf. The panels are a millimetre off. We told the owner which one it is.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>Case note</th><th></th></tr></thead><tbody><tr><td>Covering</td><td>New calf spine</td></tr><tr><td>Tooling</td><td>23-carat gold leaf</td></tr><tr><td>Tools</td><td>Small flower, two fillets</td></tr><tr><td>Hours</td><td>9</td></tr></tbody></table></figure>\n<!-- /wp:table -->"
  },
  {
   "title": "Marbled endpapers for a rebound cookbook",
   "category": "bindings",
   "image": "marbled.jpg",
   "date": "2023-12-05",
   "excerpt": "A handwritten family cookbook from Lwów, 1934, falling apart from use and butter. We resewed it and bound it in oxblood cloth.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\"} -->\n<div class=\"wp-block-columns is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/marbled.jpg\" alt=\"Open book showing a prize certificate and dark marbled endpapers\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/endpapers.jpg\" alt=\"Stone-marbled paper in pink, red and violet\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">A handwritten family cookbook from Lwów, 1934, falling apart from use and butter. We resewed it and bound it in oxblood cloth.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">For the endpapers we used a sheet of marbled paper by Anna Łoś. The owner's daughter chose it because it looked like beetroot soup.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>Case note</th><th></th></tr></thead><tbody><tr><td>Structure</td><td>Resewn, rounded and backed</td></tr><tr><td>Cloth</td><td>BR-4531 Brillianta, oxblood</td></tr><tr><td>Endpapers</td><td>Hand-marbled, Anna Łoś</td></tr><tr><td>Hours</td><td>12</td></tr></tbody></table></figure>\n<!-- /wp:table -->"
  }
 ],
