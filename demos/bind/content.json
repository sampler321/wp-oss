  {
   "title": "Sermons, Venice 1492: rebacked in calf",
   "category": "conservation",
   "image": "restored.jpg",
   "date": "2025-09-12",
   "excerpt": "The parish in Nowy Sącz brought this in a shopping bag. Both joints had gone and the spine leather came off in three pieces.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\",\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/damaged.jpg\" alt=\"Worn brown calf binding with a split spine and rubbed corners, a ruler along the edge\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/restored.jpg\" alt=\"Brown calf binding with tooled borders and a sound spine, photographed flat with a ruler below\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"66%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:66%\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">What came in</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The parish in Nowy Sącz brought this in a shopping bag. Both joints had gone and the spine leather came off in three pieces when we lifted the book out.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"34%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:34%\"><!-- wp:group {\"className\":\"is-style-sidenote\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-sidenote\"><!-- wp:paragraph -->\n<p class=\"\">Incunable, printed in Venice in 1492. Owned by the parish since at least 1740, according to the inscription.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"66%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:66%\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">What we did</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true} -->\n<ol class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Photographed and collated every leaf.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Lifted the three pieces of spine leather and kept them in order.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Cleaned the old glue off the spine with methyl cellulose poultices.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Lined the joints with Japanese tissue toned to the leather.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Put on a new spine in dyed calf and laid the old leather back on top.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Consolidated the corners with Klucel G.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"34%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:34%\"><!-- wp:group {\"className\":\"is-style-sidenote\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-sidenote\"><!-- wp:paragraph -->\n<p class=\"\"><strong>Bench time</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">31 hours over five weeks, most of it waiting for paste to dry</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"is-style-notice\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-notice\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we left alone</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The text block. The staining is five hundred years old and tells you where people held it. We did not wash, flatten or bleach a single leaf.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"45%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:45%\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/leather.jpg\" alt=\"Blind-tooled pale leather binding with an interlaced strapwork panel\"/><figcaption class=\"wp-element-caption\">A similar blind-tooled panel from our reference shelf</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"55%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:55%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">A closer look</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The front board has a blind-tooled strapwork panel. We did not re-tool it. The new spine is plain on purpose, so anyone can see where the old binding ends.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":6} -->\n<h6 class=\"wp-block-heading\">Case note</h6>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Structure</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Sewn on five raised cords, laced-in boards</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Covering</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Original calf, new calf spine</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Adhesive</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Wheat starch paste</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Size</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">21 × 15 × 4 cm</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Price</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">1,480 zł</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">We expected a bill for a new binding. We got our own book back, and it opens.</p>\n<!-- /wp:paragraph --><cite>Ks. Andrzej Nowak, parish of St Margaret, Nowy Sącz, October 2025</cite></blockquote>\n<!-- /wp:quote -->"
  },
  {
   "title": "A thesis in navy buckram, 42 copies",
   "category": "theses",
   "image": "thesis.jpg",
   "date": "2025-06-20",
   "excerpt": "Forty-two hard-case theses for the Faculty of Chemistry, all in LB-120 navy with gold on the spine. The faculty wants the surname first, so we set it that way.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\",\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/shelf.jpg\" alt=\"Title page of a 19th-century book of poems, yellowed, open flat\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/thesis.jpg\" alt=\"Decorated 19th-century cloth binding with gilt lettering and a lily on the front\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Forty-two hard-case theses for the Faculty of Chemistry, all in LB-120 navy with gold on the spine. The faculty wants the surname first, so we set it that way.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The PDFs came in on a Monday and the copies went out on Thursday. In June that is about as fast as we go.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":6} -->\n<h6 class=\"wp-block-heading\">Case note</h6>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Binding</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Hard case, sewn</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Cloth</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">LB-120 library buckram, navy</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Lettering</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Gold foil, spine and front</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Copies</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">42</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Turnaround</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">3 working days</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
  },
  {
   "title": "A clamshell box for a family prayer book",
   "category": "boxes",
   "image": "boards.jpg",
   "date": "2025-03-18",
   "excerpt": "Ewa wanted the prayer book rebound. We talked her out of it. The binding is weak but complete, and a new one would have thrown away the old repairs her grandfather made with shoe leather.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\",\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/boards.jpg\" alt=\"Dark leather-covered book with a torn and replaced corner patch, photographed flat\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/sewing.jpg\" alt=\"Brown leather binding with brass clasps resting in its new felt-lined tray\"/><figcaption class=\"wp-element-caption\">After, in the box</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"66%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:66%\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">What came in</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Ewa wanted her grandfather's prayer book rebound. The binding is weak but complete, and he had mended the corners himself with shoe leather.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"34%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:34%\"><!-- wp:group {\"className\":\"is-style-sidenote\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-sidenote\"><!-- wp:paragraph -->\n<p class=\"\">Printed in Kraków in 1896. Pages clean, sewing sound, covers tired.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"66%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:66%\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">What we did</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true} -->\n<ol class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Talked Ewa out of a rebind.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Measured the book at six points, since it is not square.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Built a two-tray clamshell in 2 mm board.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Covered it in AS-311 bottle green cloth and lined the trays with grey felt.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Stamped her grandfather's name in gold on a goatskin spine label.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"34%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:34%\"><!-- wp:group {\"className\":\"is-style-sidenote\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-sidenote\"><!-- wp:paragraph -->\n<p class=\"\"><strong>Bench time</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">9 hours</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"is-style-notice\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-notice\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we left alone</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The shoe-leather corner repairs. They are ugly and they are his, and they will outlast us.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"45%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:45%\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/marbled.jpg\" alt=\"Open book showing a pasted certificate and dark marbled endpapers\"/><figcaption class=\"wp-element-caption\">The inside of the front cover</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"55%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:55%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">A closer look</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The endpapers are marbled and the front one carries a First Communion certificate from 1931. The box keeps the cover closed without any pressure on it.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":6} -->\n<h6 class=\"wp-block-heading\">Case note</h6>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Box</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Clamshell, two trays</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Cloth</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">AS-311 Asahi, bottle green</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Lining</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Grey felt</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Label</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Goatskin, gold-stamped</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Price</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">340 zł</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">It sits on the shelf and nobody has to be careful with it any more.</p>\n<!-- /wp:paragraph --><cite>Ewa Kozłowska, Podgórze, March 2025</cite></blockquote>\n<!-- /wp:quote -->"
  },
  {
   "title": "A 1730 map of Europe, flattened and mended along the folds",
   "category": "conservation",
   "image": "map.jpg",
   "date": "2024-11-04",
   "excerpt": "Folded into sixteenths for about two hundred years, so every fold had split. We humidified it, flattened it between felts for a week and mended each fold from the back with thin kozo tissue.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\",\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/map.jpg\" alt=\"Hand-coloured 1730 map of Europe with a decorative border, folded creases visible\"/><figcaption class=\"wp-element-caption\">Before, folded</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/map.jpg\" alt=\"The same map after flattening, with the fold lines repaired from the back\"/><figcaption class=\"wp-element-caption\">After, flat</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"66%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:66%\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">What came in</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Folded into sixteenths for about two hundred years, so every fold had split and two corners were missing.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"34%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:34%\"><!-- wp:group {\"className\":\"is-style-sidenote\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-sidenote\"><!-- wp:paragraph -->\n<p class=\"\">Engraved and hand-coloured, 62 × 48 cm. Bought at a flea market in Wrocław for 40 zł.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"66%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:66%\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">What we did</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true} -->\n<ol class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Tested the colours for water sensitivity. They held.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Humidified the map in a chamber for two hours.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Flattened it between felts under light weight for a week.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Mended every fold from the back with thin kozo tissue.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Filled the two corner losses with toned paper.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Made a folder of unbuffered card.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"34%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:34%\"><!-- wp:group {\"className\":\"is-style-sidenote\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-sidenote\"><!-- wp:paragraph -->\n<p class=\"\"><strong>Bench time</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">14 hours</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"is-style-notice\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-notice\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we left alone</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The foxing. It is stable, and bleaching it out would have taken the hand-colouring with it.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"45%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:45%\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/repair.jpg\" alt=\"A conservator lifting a torn fragment with tweezers on a white board\"/><figcaption class=\"wp-element-caption\">Mending a fold from the back</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"55%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:55%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">A closer look</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Each fold gets a strip of tissue about 4 mm wide, torn, not cut, so the edge feathers into the paper and does not leave a line.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":6} -->\n<h6 class=\"wp-block-heading\">Case note</h6>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Object</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Engraved map, hand-coloured</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Repair</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Kozo tissue, wheat starch paste</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Housing</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Folder, unbuffered card</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Size</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">62 × 48 cm</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Price</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">620 zł</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">It is in a drawer now, as promised. I take it out on Sundays.</p>\n<!-- /wp:paragraph --><cite>Paweł Grzyb, Kazimierz, November 2024</cite></blockquote>\n<!-- /wp:quote -->"
  },
  {
   "title": "Red rot on a set of law reports",
   "category": "conservation",
   "image": "damaged.jpg",
   "date": "2024-09-15",
   "excerpt": "Twenty-two volumes from a law office on Grodzka. The leather came off as orange dust on every hand that touched it.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\",\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/damaged.jpg\" alt=\"Brown calf binding with powdery, rubbed leather and worn corners\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/leather.jpg\" alt=\"Leather binding after consolidation, surface stable\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"66%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:66%\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">What came in</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Twenty-two volumes from a law office on Grodzka. The leather came off as orange dust on every hand that touched it.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"34%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:34%\"><!-- wp:group {\"className\":\"is-style-sidenote\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-sidenote\"><!-- wp:paragraph -->\n<p class=\"\">Law reports, 1902 to 1924, still used by the office every month.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"66%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:66%\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">What we did</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true} -->\n<ol class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Vacuumed each volume through a screen.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Tested Klucel G at 1% and 2% on the worst spine.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Brushed 2% Klucel G in ethanol on every leather surface.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Let each volume dry standing, fanned open, overnight.</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Wrapped the three worst in protective jackets.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"34%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:34%\"><!-- wp:group {\"className\":\"is-style-sidenote\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-sidenote\"><!-- wp:paragraph -->\n<p class=\"\"><strong>Bench time</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">About 40 minutes per volume, 15 hours in all</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"is-style-notice\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-notice\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What we left alone</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The appearance. Consolidation makes red rot stop coming off; it does not make the leather look new, and we said so in the estimate.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"45%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:45%\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/shelf.jpg\" alt=\"Title page of a worn 19th-century book open flat\"/><figcaption class=\"wp-element-caption\">One of the title pages</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"55%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:55%\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">A closer look</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The paper inside is in good shape. It was only ever the leather that was falling apart.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":6} -->\n<h6 class=\"wp-block-heading\">Case note</h6>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Volumes</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">22</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Treatment</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Klucel G, 2% in ethanol</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Jackets</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">3, in Melinex</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Price</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">180 zł per volume</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p class=\"\">The shelf no longer leaves orange on my suit.</p>\n<!-- /wp:paragraph --><cite>Mec. Joanna Wrona, Grodzka Street, September 2024</cite></blockquote>\n<!-- /wp:quote -->"
  },
  {
   "title": "A small edition of poems in quarter goatskin",
   "category": "bindings",
   "image": "leather.jpg",
   "date": "2024-06-02",
   "excerpt": "Wydawnictwo Pod Wiatr printed 26 copies of Marta Nowicka's poems by letterpress and brought us the folded sheets.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\",\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/tools.jpg\" alt=\"Catalogue page of brass finishing tools and ornaments\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/leather.jpg\" alt=\"Blind-tooled pale leather binding with an interlaced panel\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Wydawnictwo Pod Wiatr printed 26 copies of Marta Nowicka's poems by letterpress and brought us the folded sheets.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">We sewed them on tapes and bound them in quarter tan goatskin with ochre Asahi sides. Ochre is AS-204, which the mill no longer makes, so we used half of our last roll.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":6} -->\n<h6 class=\"wp-block-heading\">Case note</h6>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Copies</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">26, numbered</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Binding</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Quarter leather</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Materials</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">HG-07 goatskin, AS-204 cloth</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Tooling</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Gold, spine only</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Trade terms</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">25% off</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
  },
  {
   "title": "Gold tooling a spine to match its neighbours",
   "category": "bindings",
   "image": "gilding.jpg",
   "date": "2024-02-10",
   "excerpt": "One volume of a twelve-volume set had lost its spine in a flood. The owner wanted it to sit on the shelf without anyone noticing.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\",\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/shelf.jpg\" alt=\"Title page of a worn 19th-century book\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/gilding.jpg\" alt=\"Narrow leather spine with gold-tooled small flowers\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">One volume of a twelve-volume set had lost its spine in a flood. The owner wanted it to sit on the shelf without anyone noticing.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Tomasz matched the flower tool from our drawer of old finishing tools and tooled the new spine in 23-carat gold leaf. The panels are a millimetre off. We told the owner which one it is.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":6} -->\n<h6 class=\"wp-block-heading\">Case note</h6>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Covering</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">New calf spine</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Tooling</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">23-carat gold leaf</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Tools</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Small flower, two fillets</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Hours</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">9</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
  },
  {
   "title": "Marbled endpapers for a rebound cookbook",
   "category": "bindings",
   "image": "marbled.jpg",
   "date": "2023-12-05",
   "excerpt": "A handwritten family cookbook from Lwów, 1934, falling apart from use and butter. We resewed it and bound it in oxblood cloth.",
   "content": "<!-- wp:columns {\"className\":\"is-style-pair\",\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide is-style-pair\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/marbled.jpg\" alt=\"Open book showing a prize certificate and dark marbled endpapers\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"/wp-content/themes/bind/assets/images/endpapers.jpg\" alt=\"Stone-marbled paper in pink, red and violet\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph -->\n<p class=\"\">A handwritten family cookbook from Lwów, 1934, falling apart from use and butter. We resewed it and bound it in oxblood cloth.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">For the endpapers we used a sheet of marbled paper by Anna Łoś. The owner's daughter chose it because it looked like beetroot soup.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":6} -->\n<h6 class=\"wp-block-heading\">Case note</h6>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Structure</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Resewn, rounded and backed</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Cloth</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">BR-4531 Brillianta, oxblood</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Endpapers</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Hand-marbled, Anna Łoś</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-rule-row\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group is-style-rule-row\"><!-- wp:paragraph -->\n<p class=\"\">Hours</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"\">12</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
  }
