   "excerpt": "Plum and almond, sweetcorn, the last raspberries. Sweetcorn outsold pistachio for one week, which nobody expected.",
   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Plum and almond, sweetcorn, the last raspberries. Sweetcorn outsold pistachio for one week, which nobody expected.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-flavour\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-flavour\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Plum and almond</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-note\"} -->\n<p class=\"is-note\">a special for September</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-spec\"} -->\n<p class=\"is-spec\">Specials change on the first Tuesday</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-flavour\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-flavour\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Sweetcorn and brown butter</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-note\"} -->\n<p class=\"is-note\">a special for September</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-spec\"} -->\n<p class=\"is-spec\">Specials change on the first Tuesday</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-flavour\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-flavour\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Raspberry sorbet</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-note\"} -->\n<p class=\"is-note\">a special for September</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-spec\"} -->\n<p class=\"is-spec\">Specials change on the first Tuesday</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-flavour\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is