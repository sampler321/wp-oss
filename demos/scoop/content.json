   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Peach, apricot kernel, basil. The busiest month on record, 31 days over 20 °C in total.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"is-style-flavour\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-flavour\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">White peach sorbet <sup>vg</sup></h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-note\"} -->\n<p class=\"is-note\">a special for August</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-spec\"} -->\n<p class=\"is-spec\">Specials change on the first Tuesday</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-flavour\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-flavour\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Apricot kernel</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-note\"} -->\n<p class=\"is-note\">a special for August</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-spec\"} -->\n<p class=\"is-spec\">Specials change on the first Tuesday</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-flavour\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-flavour\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Basil and lemon</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-note\"} -->\n<p class=\"is-note\">a special for August</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-spec\"} -->\n<p class=\"is-spec\">Specials change on the first Tuesday</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-flavour\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-flavour\"><!-- wp:heading