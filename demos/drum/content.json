   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Printed for The Pint Pot, Ancoats: 400 copies, A6, in fluorescent pink and black on Kraft card 280gsm.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:columns {\"className\":\"is-style-ruled\"} -->\n<div class=\"wp-block-columns is-style-ruled\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">The brief</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Flyers for a monthly print night at a pub round the corner.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">What we did</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Fluorescent pink and black on brown kraft card, so the pink really glows.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">What went wrong</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Kraft jams if you rush it. We printed at half speed.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td>Client</td><td>The Pint Pot, Ancoats</td></tr><tr><td>Run</td><td>400 copies, A6</td></tr><tr><td>Inks</td><td>Fluorescent pink and black</td></tr><tr><td>Paper</td><td>Kraft card 280gsm</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/screen.jpg' ) ); ?>\" alt=\"Hands pulling a squeegee across a pink screen at a print night\"/><figcaption class=\"wp-element-caption\">The finished job</figcaption></figure>\n<!-- /wp:image -->"
