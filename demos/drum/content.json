   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Printed for Salt Water zine collective: 500 copies, 32 pages, A5, in blue and fluorescent pink on Munken Print Cream 90gsm.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:columns {\"className\":\"is-style-ruled\"} -->\n<div class=\"wp-block-columns is-style-ruled\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">The brief</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Issue 6 of a swimming zine, 32 pages, for sale at two fairs.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">What we did</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Blue for all text and drawings, pink for the sea tints. Stapled and trimmed in a day.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">What went wrong</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Nothing much. One box got rained on outside Victoria station.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td>Client</td><td>Salt Water zine collective</td></tr><tr><td>Run</td><td>500 copies, 32 pages, A5</td></tr><tr><td>Inks</td><td>Blue and fluorescent pink</td></tr><tr><td>Paper</td><td>Munken Print Cream 90gsm</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/poster-john.jpg' ) ); ?>\" alt=\"A riso-printed poster of a woman helping a boy read, in red and black\"/><figcaption class=\"wp-element-caption\">The finished job</figcaption></figure>\n<!-- /wp:image -->"
