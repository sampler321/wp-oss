   "content": "<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Printed for Hulme Community Garden Centre: 2,000 packets, die-cut, in green and black on Cyclus Offset 100gsm.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:columns {\"className\":\"is-style-ruled\"} -->\n<div class=\"wp-block-columns is-style-ruled\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">The brief</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Seed packets for a garden centre giveaway, 2,000 of them, cut to shape.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">What we did</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Green and black on recycled offset, die-cut by a friend with a platen in Stockport.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">What went wrong</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">The die was 1mm too big. Lewis hand-trimmed 300 of them.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td>Client</td><td>Hulme Community Garden Centre</td></tr><tr><td>Run</td><td>2,000 packets, die-cut</td></tr><tr><td>Inks</td><td>Green and black</td></tr><tr><td>Paper</td><td>Cyclus Offset 100gsm</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"lightbox\":{\"enabled\":true}} -->\n<figure class=\"wp-block-image size-large\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets/images/prints-table.jpg' ) ); ?>\" alt=\"Pink, blue and green prints laid out on a round table\"/><figcaption class=\"wp-element-caption\">The finished job</figcaption></figure>\n<!-- /wp:image -->"
