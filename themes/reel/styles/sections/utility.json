{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Utility strip (black)",
	"slug": "utility",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|contrast",
			"text": "var:preset|color|base"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|base"
				},
				"typography": {
					"textDecoration": "none"
				}
			}
		},
		"typography": {
			"fontSize": "var:preset|font-size|small",
			"fontWeight": "500"
		}
	}
}
