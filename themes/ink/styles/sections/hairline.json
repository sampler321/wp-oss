{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Hairline row",
	"slug": "hairline",
	"blockTypes": [
		"core/group",
		"core/columns"
	],
	"styles": {
		"border": {
			"bottom": {
				"color": "var:preset|color|line",
				"width": "1px",
				"style": "solid"
			}
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|20",
				"bottom": "var:preset|spacing|20"
			}
		},
		"css": "&{margin-block:0!important}&>*{margin-block:0}"
	}
}
