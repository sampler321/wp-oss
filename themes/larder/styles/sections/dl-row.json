{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Definition row",
	"slug": "dl-row",
	"blockTypes": [
		"core/columns"
	],
	"styles": {
		"border": {
			"bottom": {
				"color": "var:preset|color|line",
				"width": "1px",
				"style": "dashed"
			}
		},
		"spacing": {
			"padding": {
				"bottom": "var:preset|spacing|20"
			}
		},
		"css": "& p{margin:0}"
	}
}
