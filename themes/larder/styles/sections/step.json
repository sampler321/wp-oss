{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Method step",
	"slug": "step",
	"blockTypes": [
		"core/group",
		"core/columns"
	],
	"styles": {
		"border": {
			"top": {
				"color": "var:preset|color|line",
				"width": "1px",
				"style": "solid"
			}
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|30"
			}
		},
		"css": "& .is-style-step-number{margin:0 0 .2em;line-height:1}"
	}
}
