{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Notice strip",
	"slug": "notice",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|contrast",
			"text": "var:preset|color|surface"
		},
		"typography": {
			"fontSize": "var:preset|font-size|x-small"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|surface"
				}
			}
		}
	}
}
