{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Scrawl (ballpoint note)",
	"slug": "scrawl",
	"blockTypes": [
		"core/paragraph",
		"core/heading"
	],
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|display",
			"fontSize": "var:preset|font-size|large",
			"lineHeight": "1"
		},
		"color": {
			"text": "var:preset|color|accent"
		},
		"css": "&{transform:rotate(-2deg)}"
	}
}
