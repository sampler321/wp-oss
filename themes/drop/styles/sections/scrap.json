{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Paper scrap, taped",
	"slug": "scrap",
	"blockTypes": [
		"core/group",
		"core/column",
		"core/columns"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|surface",
			"text": "var:preset|color|contrast"
		},
		"shadow": "var:preset|shadow|paper",
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|50",
				"bottom": "var:preset|spacing|50",
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"css": "&{position:relative}&::before{content:\"\";position:absolute;top:-14px;left:50%;width:120px;height:28px;margin-left:-60px;background:color-mix(in srgb,var(--wp--preset--color--tape) 80%,transparent);transform:rotate(-3deg);pointer-events:none}&{transform:rotate(-0.6deg)}"
	}
}
