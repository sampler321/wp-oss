{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Specimen line",
	"slug": "specimen",
	"blockTypes": [
		"core/paragraph",
		"core/heading"
	],
	"styles": {
		"typography": {
			"lineHeight": "0.9",
