{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "J-card",
	"slug": "jcard",
	"blockTypes": [
		"core/group",
		"core/columns"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"border": {
			"color": "var:preset|color|contrast",
			"width": "2px",
			"style": "solid",
			"radius": "4px"
		},
		"css": "&{overflow:hidden}& > .wp-block-columns{gap:0!important;margin:0}"
	}
}
