{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Colour band",
	"slug": "band",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|70",
				"bottom": "var:preset|spacing|70"
			}
		},
		"border": {
			"top": {
				"width": "3px",
				"style": "solid",
				"color": "var:preset|color|contrast"
			},
			"bottom": {
				"width": "3px",
				"style": "solid",
				"color": "var:preset|color|contrast"
			}
		}
	}
}
