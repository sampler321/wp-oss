{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Site header",
	"slug": "site-header",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"border": {
			"bottom": {
				"color": "var:preset|color|contrast",
				"width": "3px",
