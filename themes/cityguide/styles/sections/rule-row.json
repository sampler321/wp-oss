{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Ruled row",
	"slug": "rule-row",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"border": {
			"bottom": {
				"width": "1px",
				"style": "solid",
				"color": "var:preset|color|contrast"
			}
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|20",
				"bottom": "var:preset|spacing|20"
			}
		},
		"css": "&>*{margin:0!important}"
	}
}
