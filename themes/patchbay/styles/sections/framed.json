{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Framed image",
	"slug": "framed",
	"blockTypes": [
		"core/image",
		"core/post-featured-image"
	],
	"styles": {
		"border": {
			"width": "3px",
			"style": "solid",
			"color": "var:preset|color|contrast",
			"radius": "14px"
		},
		"css": "&{overflow:hidden}& img{display:block}"
	}
}
