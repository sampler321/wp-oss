{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Pill label",
	"slug": "pill",
	"blockTypes": [
		"core/paragraph"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|cream",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontWeight": "800",
			"fontSize": "var:preset|font-size|x-small"
		},
		"border": {
			"radius": "999px"
		},
		"css": "&{display:inline-block;padding:.35em 1em!important}"
	}
}
