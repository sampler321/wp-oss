{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Notice line",
	"slug": "notice",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|accent",
			"text": "var:preset|color|base"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|base"
				}
			}
		},
		"typography": {
			"fontSize": "var:preset|font-size|x-small",
			"letterSpacing": "0.02em"
		}
	}
}
