{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Bespoke stage row",
	"slug": "stage",
	"blockTypes": [
		"core/columns"
	],
	"styles": {
		"border": {
			"top": {
				"color": "var:preset|color|contrast",
				"width": "1px",
				"style": "solid"
			}
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|40",
				"bottom": "var:preset|spacing|50"
			},
			"margin": {
				"top": "0",
				"bottom": "0"
			}
		}
	}
}
