{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Label plate",
	"slug": "label-plate",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|surface",
			"text": "var:preset|color|contrast"
		},
		"border": {
			"width": "2px",
			"style": "solid",
			"color": "var:preset|color|contrast"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|30",
				"bottom": "var:preset|spacing|30",
				"left": "var:preset|spacing|30",
				"right": "var:preset|spacing|30"
			}
		},
		"css": "&{text-align:center;width:78%;margin-inline:auto!important}& h2{text-align:center}& h3{text-align:center}& p{text-align:center}& .wp-block-separator{width:40%;margin:.5rem auto!important;border-top-width:1px}"
	}
}
