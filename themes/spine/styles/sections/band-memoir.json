{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Band: memoir",
	"slug": "band-memoir",
	"blockTypes": [
		"core/group",
		"core/column",
		"core/columns"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|memoir",
			"text": "var:preset|color|base"
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				}
			},
			"heading": {
				"color": {
					"text": "currentColor"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|memoir"
				},
				"border": {
					"color": "var:preset|color|base"
				}
			}
		},
		"css": "& a{text-decoration-color:currentColor}"
	}
}
