{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Orange bar",
	"slug": "orange-bar",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|accent",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|contrast"
				}
			}
		},
		"typography": {
			"fontWeight": "500",
			"fontSize": "var:preset|font-size|small"
		},
		"css": "& a{text-decoration-color:currentColor}"
	}
}
