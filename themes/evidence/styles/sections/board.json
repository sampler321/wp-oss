{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Case board",
	"slug": "board",
	"blockTypes": [
		"core/group",
		"core/columns"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|surface",
			"text": "var:preset|color|contrast"
		},
		"border": {
			"top": {
				"color": "var:preset|color|line",
				"width": "1px",
				"style": "solid"
			},
			"bottom": {
				"color": "var:preset|color|line",
				"width": "1px",
				"style": "solid"
			}
		}
	}
}
