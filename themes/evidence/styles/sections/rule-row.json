{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Ruled row",
	"slug": "rule-row",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"border": {
			"top": {
				"color": "var:preset|color|line",
				"width": "1px",
				"style": "solid"
			}
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|20",
				"bottom": "var:preset|spacing|20"
			}
		},
		"css": "& p:first-child{color:var(--wp--preset--color--accent-2)}"
	}
}
