{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Round sticker",
	"slug": "sticker",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|accent",
			"text": "var:preset|color|base"
		},
		"border": {
			"radius": "50%"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|display",
			"fontSize": "var:preset|font-size|large",
			"lineHeight": "1"
		},
		"css": "&{aspect-ratio:1;width:9.5rem;display:flex;align-items:center;justify-content:center;text-align:center;transform:rotate(-12deg);padding:1rem}& p{margin:0}"
	}
}
