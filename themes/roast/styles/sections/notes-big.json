{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Tasting notes (big)",
	"slug": "notes-big",
	"blockTypes": [
		"core/paragraph"
	],
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|display",
			"fontSize": "var:preset|font-size|x-large",
			"lineHeight": "1.15",
			"letterSpacing": "-0.03em"
		},
		"css": "&{overflow-wrap:normal;word-break:normal;hyphens:none}"
	}
}
