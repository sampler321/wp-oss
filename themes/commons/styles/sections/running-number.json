{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Running number",
	"slug": "running-number",
	"blockTypes": [
		"core/post-terms",
		"core/paragraph"
	],
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|display",
			"fontWeight": "400",
			"fontSize": "var:preset|font-size|large",
			"lineHeight": "1",
			"letterSpacing": "-0.02em"
		},
		"color": {
			"text": "var:preset|color|accent"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				"typography": {
					"textDecoration": "none"
				}
			}
		}
	}
}
