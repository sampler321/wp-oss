{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Wall wordmark",
	"slug": "wordmark",
	"blockTypes": [
		"core/heading",
		"core/paragraph"
	],
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|display",
			"fontSize": "var:preset|font-size|display",
			"lineHeight": "0.8",
			"letterSpacing": "-0.01em",
			"textTransform": "uppercase"
		},
		"spacing": {
			"margin": {
				"top": "0",
				"bottom": "0"
			}
		},
		"css": "&{overflow-wrap:anywhere}"
	}
}
