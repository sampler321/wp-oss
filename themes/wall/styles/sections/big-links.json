{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Big text links",
	"slug": "big-links",
	"blockTypes": [
		"core/paragraph",
		"core/list"
	],
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|display",
			"fontSize": "var:preset|font-size|xx-large",
			"lineHeight": "0.9",
			"textTransform": "uppercase"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-2"
					}
				}
			}
		},
		"css": "&{list-style:none;padding-left:0}"
	}
}
