{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Signal blue block",
	"slug": "signal",
	"blockTypes": [
		"core/group",
		"core/column"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|accent",
			"text": "var:preset|color|base"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|base"
				},
				"typography": {
					"textDecoration": "underline"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|base"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|accent"
				},
				"border": {
					"color": "var:preset|color|base"
				}
			}
		},
		"css": "& .wp-block-table td,& .wp-block-table th{border-color:var(--wp--preset--color--base)}"
	}
}
