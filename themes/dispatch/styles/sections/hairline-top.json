{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Hairline above",
	"slug": "hairline-top",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"border": {
			"top": {
				"color": "var:preset|color|hairline",
				"width": "1px",
				"style": "solid"
			}
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|20",
				"bottom": "var:preset|spacing|20"
			}
		}
	}
}
