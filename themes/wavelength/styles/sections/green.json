{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Moor green block",
	"slug": "green",
	"blockTypes": [
		"core/group",
		"core/column"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|contrast",
			"text": "var:preset|color|base"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|accent-2"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|base"
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|surface"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent-2",
					"text": "var:preset|color|contrast"
				},
				"border": {
					"color": "var:preset|color|accent-2"
				}
			}
		},
		"css": "& .has-muted-color{color:var(--wp--preset--color--surface)!important}& .wp-block-table td,& .wp-block-table th,& .wp-block-table thead{border-color:var(--wp--preset--color--base)}"
	}
}
