{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "base",
					"color": "#F2F3EF",
					"name": "Drafting film"
				},
				{
					"slug": "contrast",
					"color": "#1B2430",
					"name": "Graphite"
				},
				{
					"slug": "accent",
					"color": "#A57A2C",
					"name": "Brass"
				},
				{
					"slug": "accent-2",
					"color": "#7A1F1F",
					"name": "Case oxblood"
				},
				{
					"slug": "surface",
					"color": "#E3E5DF",
					"name": "Plate grey"
				},
				{
					"slug": "line",
					"color": "#8E989E",
					"name": "Hairline"
				},
				{
					"slug": "muted",
					"color": "#4E5963",
					"name": "Pencil"
				},
				{
					"slug": "paper",
					"color": "#FFFFFF",
					"name": "Slip paper"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"textAlign": true,
			"writingMode": false,
			"fontFamilies": [
