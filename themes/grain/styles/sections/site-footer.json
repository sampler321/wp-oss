{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Site footer",
	"slug": "site-footer",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|surface"
		},
		"border": {
			"top": {
				"color": "var:preset|color|line",
				"width": "1px",
				"style": "solid"
			}
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|70",
				"bottom": "var:preset|spacing|50"
			}
		}
	}
}
