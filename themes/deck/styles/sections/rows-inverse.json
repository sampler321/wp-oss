{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Ruled rows on black",
	"slug": "rows-inverse",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"css": "& > .wp-block-group{border-bottom:3px solid var(--wp--preset--color--accent);padding:.55em 0!important;margin:0!important;column-gap:1rem!important}& > .wp-block-group > p{margin:0!important}& > .wp-block-group > p:first-child{font-family:var(--wp--preset--font-family--display);text-transform:uppercase;font-size:var(--wp--preset--font-size--large);color:var(--wp--preset--color--accent-2);line-height:1}"
	}
}
