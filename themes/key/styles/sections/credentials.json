{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Credentials row",
	"slug": "credentials",
	"blockTypes": [
		"core/group",
		"core/columns"
	],
	"styles": {
		"border": {
			"top": {
				"color": "var:preset|color|brass",
				"width": "3px",
				"style": "solid"
			},
			"bottom": {
				"color": "var:preset|color|brass",
				"width": "3px",
				"style": "solid"
			}
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|30",
				"bottom": "var:preset|spacing|30"
			}
		},
		"typography": {
			"fontSize": "var:preset|font-size|small"
		}
	}
}
